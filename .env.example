# Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigc_dd
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_DIALECT=postgres
DB_SSL=true

# Aplicación
APP_PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=tu_clave_secreta_aqui

# API keys de integración (tokens estáticos, SOLO LECTURA)
# Producción: define API_KEYS_JSON con las keys que consumirán las apps
# externas. SOLO se cargan cuando NODE_ENV=production. Genera cada token con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Formato: {"keys":[{"keyId":"app-externa","token":"<hex>","scopes":["read"]}]}
# Alternativa: API_KEYS_FILE=/ruta/absoluta/al/archivo.json (mismo formato)
# Desarrollo: usa config/apiKeys.json (gitignored), copia de
# config/apiKeys.example.json. No uses el mismo token en dev y prod.
#API_KEYS_JSON={"keys":[{"keyId":"app-externa","token":"<token-hex-prod>","scopes":["read"]}]}
#API_KEYS_FILE=/ruta/a/apiKeys.prod.json

# Versión
VERSION_NAME=Chocobreak
